# =========================================================
# Unreal Engine generated folders
# =========================================================

Binaries/
Intermediate/
Saved/
DerivedDataCache/

Plugins/**/Binaries/
Plugins/**/Intermediate/


# =========================================================
# Packaged builds
# =========================================================

# Build esportate tramite Package Project.
# Devono rimanere locali e non essere versionate.
/Builds/


# =========================================================
# Unreal Build folder
# =========================================================

# La cartella Build può contenere file generati,
# ma alcuni file di configurazione/icon possono essere utili.
Build/*

# Mantiene accessibili le sottocartelle per le eccezioni.
!Build/*/
Build/*/**

# Mantiene eventuali PakBlacklist.
!Build/*/PakBlacklist*.txt

# Mantiene le icone utilizzate dalla build Windows.
!Build/**/*.ico


# =========================================================
# Precompiled / source art
# =========================================================

SourceArt/**/*.png
SourceArt/**/*.tga


# =========================================================
# Generated map data
# =========================================================

*_BuiltData.uasset